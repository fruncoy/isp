rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    function isSalesRep() {
      return isAuthenticated() && getUserData().role == 'salesrep';
    }

    // --- Collection Rules ---

    // USERS Collection
    match /users/{userId} {
      // Allow users to read their own profile without calling isAdmin() to avoid recursion
      allow read: if isAuthenticated() && (request.auth.uid == userId || (request.auth.uid != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update, delete: if isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // CUSTOMERS Collection
    match /customers/{customerId} {
      allow read, write: if isAuthenticated() && (isAdmin() || isSalesRep());
    }

    // SALES Collection
    match /sales/{saleId} {
      allow read, write: if isAuthenticated() && (isAdmin() || isSalesRep());
    }

    // PAYMENTS Collection
    match /payments/{paymentId} {
      allow read, write: if isAuthenticated() && (isAdmin() || isSalesRep());
    }

    // PACKAGES Collection (Dynamic Services)
    match /packages/{packageId} {
      // Sales reps need to read packages to show them in dropdowns
      allow read: if isAuthenticated();
      // Only admins can modify the catalogue
      allow write: if isAdmin();
    }

    // LOGS Collection (Activity Tracking)
    match /logs/{logId} {
      // Everyone can create logs (to record their actions)
      allow create: if isAuthenticated();
      // Only admins can view the activity log history
      allow read: if isAdmin();
      // Nobody should be able to update or delete logs once written
      allow update, delete: if false;
    }

    // NOTIFICATIONS Collection
    match /notifications/{notificationId} {
      // Allow user to read their own notifications
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Allow creation of notifications
      allow create: if isAuthenticated();
    }
  }
}
